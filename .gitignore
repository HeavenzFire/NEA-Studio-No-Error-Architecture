```gitignore
# Environment files
.env
.env.local
*.env.*

# Logs and temporary files
*.log
*.tmp
*.swp

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.venv*/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.DS_Store
Thumbs.db

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Build and distribution
dist/
build/
*.egg-info/
.eggs/
develop-eggs/
.installed.cfg
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
```