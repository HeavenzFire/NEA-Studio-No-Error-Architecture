```gitignore
# Compiled Python files
__pycache__/
*.pyc

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editors/IDE
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Build artifacts
dist/
build/
target/

# Dependencies
node_modules/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.gradle/

# System files
.DS_Store
Thumbs.db
```